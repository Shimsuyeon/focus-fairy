{
	"manifest_version": 3,
	"name": "집중요정",
	"description": "Slack 집중요정 봇과 연결해 툴바에서 집중을 시작·종료하고, 함께 집중하는 팀원과 이번 달 기록을 확인해요.",
	"version": "1.0.0",
	"homepage_url": "https://focus-fairy-docs.pages.dev/extension/",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "집중요정",
		"default_popup": "popup.html"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": ["storage", "alarms"],
	"content_scripts": [
		{
			"matches": ["https://focus-fairy.suyeonshim.workers.dev/extension/connect*", "http://localhost:8787/extension/connect*"],
			"js": ["connect.js"]
		}
	],
	"host_permissions": ["https://focus-fairy.suyeonshim.workers.dev/*", "http://localhost:8787/*"],
	"commands": {
		"_execute_action": {
			"suggested_key": { "default": "Alt+Shift+F" },
			"description": "집중요정 팝업 열기"
		},
		"toggle-focus": {
			"suggested_key": { "default": "Alt+Shift+S" },
			"description": "집중 시작 / 일시정지 / 재개"
		}
	}
}
